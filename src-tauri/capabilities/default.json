{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main", "category-notes", "category-notes-all", "category-notes-*", "note-editor-*", "notes-ref", "notes-ref-*", "ai-copilot", "ai-copilot-*", "plugin-workshop", "plugin-workshop-*", "plugin-script-*", "remote-desktop", "remote-desktop-*", "sftp", "sftp-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "core:event:default"
  ]
}
