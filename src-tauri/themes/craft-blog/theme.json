{
  "id": "craft-blog",
  "name": "Craft Blog",
  "version": "2.0.0",
  "type": "blog",
  "license": "free",
  "description": "极简双栏博客主题（v2）：现代排版 + 深色模式，WebCraft 默认主题",
  "supports": ["tags", "category", "archive"],
  "settings": [
    { "key": "tagline", "label": "站点标语", "type": "text", "default": "" },
    { "key": "accent_color", "label": "强调色", "type": "color", "default": "#0F766E" },
    { "key": "dark_mode", "label": "深色模式", "type": "select", "default": "auto", "options": [
      { "value": "auto", "label": "跟随系统" },
      { "value": "light", "label": "始终浅色" },
      { "value": "dark", "label": "始终深色" }
    ]}
  ]
}
